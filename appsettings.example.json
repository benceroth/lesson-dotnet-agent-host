{
  "Host": {
    "AllowAnonymous": false
  },

  "Callers": {
    "Map": {
      "{{ChannelUserId}}": "{{CustomerId}}"
    }
  },

  "State": {
    "Provider": "Sqlite",
    "SqlitePath": "northstar-state.db"
  },

  "Support": {
    "TurnTimeout": "00:00:10",
    "MaxMessageLength": 1000
  },

  "TokenValidation": {
    "Audiences": [ "{{ClientId}}" ],
    "TenantId": "{{TenantId}}"
  },

  "Connections": {
    "ServiceConnection": {
      "Settings": {
        "AuthType": "ClientSecret",
        "AuthorityEndpoint": "https://login.microsoftonline.com/{{TenantId}}",
        "ClientId": "{{ClientId}}",
        "ClientSecret": "{{ClientSecret-use-user-secrets-or-env-never-commit}}",
        "Scopes": [ "https://api.botframework.com/.default" ]
      }
    }
  },
  "ConnectionsMap": [
    { "ServiceUrl": "*", "Connection": "ServiceConnection" }
  ]
}
