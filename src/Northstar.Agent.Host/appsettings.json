{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Host": {
    "AllowAnonymous": false
  },
  "State": {
    "Provider": "InMemory",
    "SqlitePath": "northstar-state.db"
  },
  "Support": {
    "TurnTimeout": "00:00:10",
    "MaxMessageLength": 1000
  }
}
